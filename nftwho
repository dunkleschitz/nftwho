class LoadError(Exception):
    """Unrecoverable load failure: exit 2 with the cap/reason named."""


class Tri:
    TRUE = "TRUE"
    FALSE = "FALSE"
    UNKNOWN = "UNKNOWN"


def tri_and(values):
    if Tri.FALSE in values:
        return Tri.FALSE
    if Tri.UNKNOWN in values:
        return Tri.UNKNOWN
    return Tri.TRUE


def tri_not(value):
    if value == Tri.TRUE:
        return Tri.FALSE
    if value == Tri.FALSE:
        return Tri.TRUE
    return Tri.UNKNOWN


# ---------------------------------------------------------------- tokenizer

class Token:
    __slots__ = ("text", "file", "line", "quoted")

    def __init__(self, text, file, line, quoted=False):
        self.text = text
        self.file = file
        self.line = line
        self.quoted = quoted

    def __repr__(self):
        return "Tok(%r@%s:%d)" % (self.text, self.file, self.line)


_WORD_START = re.compile(r"[A-Za-z0-9_@$/]")
_WORD_CHAR = re.compile(r"[A-Za-z0-9_./:+@$]")


def tokenize(text, fname):
    """NF00 tokenizer: braces/semicolons/operators are distinct tokens,
    quoted strings are single tokens even with spaces/braces/# inside,
    comments run # to end of line outside quotes."""
    toks = []
    i, n = 0, len(text)
    line = 1
    while i < n:
        c = text[i]
        if c == "\n":
            line += 1
            i += 1
        elif c in " \t\r":
            i += 1
        elif c == "#":
            while i < n and text[i] != "\n":
                i += 1
        elif c == '"':
            j = i + 1
            buf = []
            while j < n and text[j] != '"':
                if text[j] == "\\" and j + 1 < n:
                    buf.append(text[j + 1])
                    j += 2
                else:
                    if text[j] == "\n":
                        line += 1
                    buf.append(text[j])
                    j += 1
            if j >= n:
                raise LoadError("unterminated quoted string in %s:%d" % (fname, line))
            toks.append(Token("".join(buf), fname, line, quoted=True))
            i = j + 1
        elif text[i:i + 2] in ("==", "!=", ">=", "<=", "<<", ">>"):
            toks.append(Token(text[i:i + 2], fname, line))
            i += 2
        elif c in "{};,.":
            toks.append(Token(c, fname, line))
            i += 1
        elif c in "&|<>=":
            toks.append(Token(c, fname, line))
            i += 1
        elif c == "-" and i + 1 < n and text[i + 1].isdigit() \
                and (i == 0 or not _WORD_CHAR.match(text[i - 1])):
            # negative number / standalone minus
            toks.append(Token("-", fname, line))
            i += 1
        elif _WORD_START.match(c):
            j = i
            while j < n and _WORD_CHAR.match(text[j]):
                j += 1
            # a '-' joins a word only when glued on both sides (8000-9000,
            # eth-0, 10.0.0.10-10.0.0.20)
            while j < n and text[j] == "-" and j + 1 < n \
                    and _WORD_CHAR.match(text[j + 1]) \
                    and _WORD_CHAR.match(text[j - 1]):
                j += 1
                while j < n and _WORD_CHAR.match(text[j]):
                    j += 1
            if j == i:
                j = i + 1  # guarantee progress: never emit an empty token
            toks.append(Token(text[i:j], fname, line))
            i = j
        elif c == "*":
            toks.append(Token("*", fname, line))
            i += 1
        elif c == "!":
            toks.append(Token("!", fname, line))
            i += 1
        elif c == "-":
            toks.append(Token("-", fname, line))
            i += 1
        else:
            # Any other stray character: keep as its own token so the
            # recognizer can flag it rather than the loader dying.
            toks.append(Token(c, fname, line))
            i += 1
    return toks


# ---------------------------------------------------------------- stream loader

class StreamLoader:
    """NF02/NF03/NF04: one merged token stream with include expansion
    (NF03) and sequential define substitution (NF04), under NF30 caps."""

    def __init__(self, main_path, includepaths):
        self.main_path = main_path
        self.includepaths = list(includepaths or [])
        self.files_read = []          # (path, via) in read order
        self.include_edges = []       # (including file, pattern, resolved)
        self.defines_expanded = []    # (name, file, line) of uses
        self.findings = []            # loader-level findings
        self._included_count = 0

    def _read_file(self, path):
        try:
            with open(path, "r", errors="replace") as fh:
                return fh.read()
        except OSError as exc:
            raise LoadError("cannot read %s: %s" % (path, exc))

    def _resolve_include(self, pattern, including_file):
        """NF03: --includepath dirs, then the including file's directory.
        Returns a sorted list of resolved files (empty = wildcard no-match)."""
        candidates = []
        if os.path.isabs(pattern):
            candidates.append(pattern)
        else:
            for d in self.includepaths:
                candidates.append(os.path.join(d, pattern))
            inc_dir = os.path.dirname(os.path.abspath(including_file))
            candidates.append(os.path.join(inc_dir, pattern))
        has_wild = any(ch in pattern for ch in "*?[")
        seen = []
        for cand in candidates:
            if has_wild:
                matches = sorted(glob.glob(cand))
                # dotfiles are never matched by a wildcard (NF03)
                matches = [m for m in matches
                           if not os.path.basename(m).startswith(".")]
                for m in matches:
                    if m not in seen:
                        seen.append(m)
                if seen:
                    break
            else:
                if os.path.isfile(cand):
                    return [cand]
        return seen

    def _expand_file(self, path, via, stack):
        if len(stack) > MAX_INCLUDE_DEPTH:
            raise LoadError("include depth cap exceeded (%d) at %s"
                            % (MAX_INCLUDE_DEPTH, path))
        real = os.path.realpath(path)
        if real in stack:
            raise LoadError("include cycle involving %s" % path)
        if self._included_count >= MAX_INCLUDE_FILES:
            raise LoadError("include file cap exceeded (%d)"
                            % MAX_INCLUDE_FILES)
        self._included_count += 1
        text = self._read_file(path)
        if len(text) > MAX_STREAM_BYTES:
            raise LoadError("stream size cap exceeded (%d bytes) at %s"
                            % (MAX_STREAM_BYTES, path))
        self.files_read.append((path, via))
        toks = tokenize(text, path)
        out = []
        stack = stack + [real]
        i = 0
        while i < len(toks):
            tok = toks[i]
            if tok.text == "include" and not tok.quoted \
                    and i + 1 < len(toks) and toks[i + 1].quoted:
                pattern = toks[i + 1].text
                resolved = self._resolve_include(pattern, path)
                has_wild = any(ch in pattern for ch in "*?[")
                if not resolved and not has_wild:
                    raise LoadError(
                        "include %r in %s:%d resolves nowhere"
                        % (pattern, tok.file, tok.line))
                for target in resolved:
                    self.include_edges.append((path, pattern, target))
                    out.extend(self._expand_file(
                        target, "include %r" % pattern, stack))
                i += 2
                continue
            out.append(tok)
            i += 1
        return out

    def load(self):
        if not os.path.isfile(self.main_path):
            raise LoadError("cannot read %s: no such file" % self.main_path)
        toks = self._expand_file(self.main_path, "main file", [])
        if len(toks) > MAX_TOKENS:
            raise LoadError("token cap exceeded (%d)" % MAX_TOKENS)
        return self._apply_defines(toks)

    def _apply_defines(self, toks):
        """Sequential single-pass define substitution (NF04). Returns a
        list of statements (token lists); define statements are consumed."""
        stmts = split_statements(toks)
        defines = {}   # name -> (value tokens, file, line)
        out = []
        for stmt in stmts:
            if len(stmt) >= 2 and stmt[0].text == "define" and not stmt[0].quoted:
                name = stmt[1].text
                if len(stmt) >= 4 and stmt[2].text == "=":
                    defines[name] = (stmt[3:], stmt[1].file, stmt[1].line)
                else:
                    self.findings.append({
                        "code": "unparseable",
                        "message": "malformed define statement",
                        "file": stmt[0].file, "line": stmt[0].line})
                continue
            expanded = self._expand_stmt(stmt, defines, 0)
            out.append(expanded)
        return out

    def _expand_stmt(self, stmt, defines, depth):
        out = []
        for tok in stmt:
            if tok.text.startswith("$") and not tok.quoted and len(tok.text) > 1:
                name = tok.text[1:]
                if name not in defines:
                    # NF04: undefined define is a poison marker the parser
                    # turns into [undefined-define] at that position.
                    out.append(Token("__UNDEFINED_DEFINE__:" + name,
                                     tok.file, tok.line))
                    continue
                if depth >= MAX_DEFINE_DEPTH:
                    raise LoadError(
                        "define expansion depth cap exceeded (%d) at %s:%d"
                        % (MAX_DEFINE_DEPTH, tok.file, tok.line))
                self.defines_expanded.append((name, tok.file, tok.line))
                value, _vf, _vl = defines[name]
                # Substituted tokens take the USE site's file:line, so
                # statement splitting and rule provenance stay at the
                # rule as written (the define's own site is recorded
                # separately in defines_expanded).
                out.extend(self._expand_tokens(value, defines, depth + 1,
                                               tok))
            else:
                out.append(tok)
        return out

    def _expand_tokens(self, toks, defines, depth, use_tok=None):
        out = []
        for tok in toks:
            if tok.text.startswith("$") and not tok.quoted and len(tok.text) > 1:
                name = tok.text[1:]
                if name not in defines:
                    out.append(Token("__UNDEFINED_DEFINE__:" + name,
                                     tok.file, tok.line))
                    continue
                if depth >= MAX_DEFINE_DEPTH:
                    raise LoadError(
                        "define expansion depth cap exceeded (%d) at %s:%d"
                        % (MAX_DEFINE_DEPTH, tok.file, tok.line))
                value, _vf, _vl = defines[name]
                out.extend(self._expand_tokens(value, defines, depth + 1,
                                               use_tok or tok))
            else:
                if use_tok is not None:
                    out.append(Token(tok.text, use_tok.file, use_tok.line,
                                     tok.quoted))
                else:
                    out.append(tok)
        if len(out) > MAX_DEFINE_EXPANSION:
            raise LoadError("define expansion cap exceeded (%d)"
                            % MAX_DEFINE_EXPANSION)
        return out


_OPERATOR_TOKENS = {"==", "!=", ">=", "<=", ">", "<", "&", "|", "<<", ">>",
                    "=", ",", ".", "-", "+", "in"}


def split_statements(toks):
    """NF00 statement orientation: split a token list into statements.
    A statement ends at a ';' at brace depth 0, at a newline at brace
    depth 0 (unless the buffer ends with an operator, i.e. the
    statement continues), or at the matching close of an outer block.
    Braces, quotes and comments are already handled by the tokenizer."""
    stmts = []
    buf = []
    depth = 0
    prev_line = None
    prev_file = None
    for tok in toks:
        if tok.text == "{":
            depth += 1
        if depth == 0 and buf and (tok.file, tok.line) != (prev_file, prev_line) \
                and buf[-1].text not in _OPERATOR_TOKENS \
                and buf[-1].text != "{":
            stmts.append(buf)
            buf = []
        if tok.text == "}" and depth > 0:
            depth -= 1
        if tok.text == ";" and depth == 0:
            if buf:
                stmts.append(buf)
                buf = []
            prev_line = tok.line
            prev_file = tok.file
            continue
        buf.append(tok)
        prev_line = tok.line
        prev_file = tok.file
    if buf:
        stmts.append(buf)
    return stmts


def brace_body(toks):
    """Return (inner tokens, rest) for a '{ ... }' starting at toks[0]."""
    if not toks or toks[0].text != "{":
        return None, toks
    depth = 0
    for i, tok in enumerate(toks):
        if tok.text == "{":
            depth += 1
        elif tok.text == "}":
            depth -= 1
            if depth == 0:
                return toks[1:i], toks[i + 1:]
    return None, toks


def split_top_commas(toks):
    """Split token list on ',' at brace depth 0 (set/map element lists)."""
    parts, buf, depth = [], [], 0
    for tok in toks:
        if tok.text == "{":
            depth += 1
        elif tok.text == "}":
            depth -= 1
        if tok.text == "," and depth == 0:
            parts.append(buf)
            buf = []
        else:
            buf.append(tok)
    if buf:
        parts.append(buf)
    return [p for p in parts if p]


def parse_int(text):
    try:
        return int(text, 0)
    except (ValueError, TypeError):
        return None

# ---------------------------------------------------------------- model

class Finding:
    def __init__(self, code, message, file=None, line=None):
        self.code = code
        self.message = message
        self.file = file
        self.line = line

    def where(self):
        if self.file is not None:
            return "%s:%s" % (self.file, self.line)
        return "?"

    def to_dict(self):
        d = {"code": self.code, "message": self.message}
        if self.file is not None:
            d["file"] = self.file
            d["line"] = self.line
        return d


class Table:
    def __init__(self, family, name, file, line):
        self.family = family
        self.name = name
        self.file = file
        self.line = line
        self.chains = {}     # name -> Chain (insertion order = stream order)
        self.sets = {}       # name -> NamedSet
        self.maps = {}       # name -> NamedMap
        self.objects = {}    # counter/quota/limit/flowtable names


class Chain:
    def __init__(self, table, name, file, line):
        self.table = table
        self.name = name
        self.file = file
        self.line = line
        self.type = None     # filter | nat | route | None (regular)
        self.hook = None
        self.priority = None
        self.priority_raw = None
        self.policy = "accept"
        self.policy_line = line
        self.rules = []
        self.stream_index = 0
        self.priority_poisoned = False

    @property
    def is_base(self):
        return self.hook is not None

    def ident(self):
        return "%s %s %s" % (self.table.family, self.table.name, self.name)


class NamedSet:
    def __init__(self, table, name, file, line):
        self.table = table
        self.name = name
        self.file = file
        self.line = line
        self.type = None
        self.flags = set()
        self.elements = []   # list of element specs
        self.poisoned = False
        self.poison_reason = None

    @property
    def dynamic(self):
        return "dynamic" in self.flags

    @property
    def timeout(self):
        return "timeout" in self.flags


class NamedMap:
    def __init__(self, table, name, file, line):
        self.table = table
        self.name = name
        self.file = file
        self.line = line
        self.key_type = None
        self.value_type = None
        self.flags = set()
        self.elements = []   # list of (key spec, value spec)
        self.poisoned = False
        self.poison_reason = None

    @property
    def is_verdict(self):
        return self.value_type == "verdict"

    @property
    def dynamic(self):
        return "dynamic" in self.flags

    @property
    def timeout(self):
        return "timeout" in self.flags


class Rule:
    def __init__(self, chain, file, line):
        self.chain = chain
        self.file = file
        self.line = line
        self.matches = []    # list of Expr dicts
        self.statements = []  # list of Stmt dicts
        self.unparseable = False
        self.unparseable_reason = None
        self.text = ""

    def has_terminal(self):
        for st in self.statements:
            if st["kind"] in ("accept", "drop", "reject", "queue",
                              "jump", "goto", "nat"):
                return True
            if st["kind"] == "vmap":
                return True
        return False

    def has_mutation(self):
        return any(st["kind"] in ("mark-set", "ctmark-set", "notrack")
                   for st in self.statements)


# Value specs: dicts with "kind":
#  lit (text), prefix (network), range (lo,hi as ints or ip ints),
#  setlit (list of element specs), named (@set), tuple (list of specs),
#  list (list of specs), hostname, service (name), unknown (reason, code)
def v_lit(text):
    return {"kind": "lit", "text": text}


def v_unknown(code, message):
    return {"kind": "unknown", "code": code, "message": message}


def parse_number(text):
    return parse_int(text)


def looks_like_ip(text):
    try:
        ipaddress.ip_address(text)
        return True
    except ValueError:
        return False


def parse_range_token(text):
    """'8000-9000' or '10.0.0.10-10.0.0.20' -> (lo, hi) as ints, or None."""
    if "-" not in text:
        return None
    parts = text.split("-")
    if len(parts) != 2:
        return None
    lo, hi = parts
    nlo, nhi = parse_int(lo), parse_int(hi)
    if nlo is not None and nhi is not None:
        return ("num", nlo, nhi)
    try:
        ilo = int(ipaddress.ip_address(lo))
        ihi = int(ipaddress.ip_address(hi))
        return ("ip", ilo, ihi)
    except ValueError:
        return None


def parse_value_tokens(toks, ctx):
    """Parse a value position: literal / prefix / range / { set } /
    @named / comma list / hostname / service name. Consumes from the
    front of toks (a list) and returns (value spec, remaining toks)."""
    if not toks:
        return v_unknown("unparseable", "missing value"), toks
    tok = toks[0]
    if tok.text.startswith("__UNDEFINED_DEFINE__"):
        name = tok.text.split(":", 1)[1]
        ctx.findings.append(Finding(
            "undefined-define", "use of undefined define $%s" % name,
            tok.file, tok.line))
        return v_unknown("undefined-define",
                         "undefined define $%s" % name), toks[1:]
    if tok.text == "{":
        inner, rest = brace_body(toks)
        if inner is None:
            return v_unknown("unparseable", "unbalanced { in value"), toks[1:]
        elems = []
        for part in split_top_commas(inner):
            elem, _ = parse_value_tokens(part, ctx)
            elems.append(elem)
        return {"kind": "setlit", "elements": elems}, rest
    if tok.text.startswith("@"):
        return {"kind": "named", "name": tok.text[1:]}, toks[1:]
    if tok.text == "*":
        return {"kind": "lit", "text": "*"}, toks[1:]
    # tuple / single value possibly followed by ', ...' list
    first, rest = parse_single_value(tok, ctx)
    if rest and rest[0].text == ",":
        vals = [first]
        rest = rest[1:]
        while rest:
            v, rest = parse_single_value(rest[0], ctx) if rest else (None, rest)
            if v is None:
                break
            vals.append(v)
            if rest and rest[0].text == ",":
                rest = rest[1:]
            else:
                break
        return {"kind": "list", "values": vals}, rest
    return first, rest


def parse_single_value(tok, ctx):
    """One atomic value token (no braces, no @, no comma list)."""
    text = tok.text
    if text.startswith("__UNDEFINED_DEFINE__"):
        name = text.split(":", 1)[1]
        ctx.findings.append(Finding(
            "undefined-define", "use of undefined define $%s" % name,
            tok.file, tok.line))
        return v_unknown("undefined-define",
                         "undefined define $%s" % name), []
    # range written as one token (8000-9000, 10.0.0.10-10.0.0.20)
    rng = parse_range_token(text)
    if rng is not None:
        return {"kind": "range", "rtype": rng[0], "lo": rng[1],
                "hi": rng[2]}, []
    # range written as three tokens: VAL - VAL
    if "/" in text and not text.startswith("/"):
        try:
            net = ipaddress.ip_network(text, strict=False)
            return {"kind": "prefix", "network": net}, []
        except ValueError:
            pass
    if looks_like_ip(text):
        return v_lit(text), []
    if parse_int(text) is not None:
        return v_lit(text), []
    if re.match(r"^[A-Za-z][A-Za-z0-9_.-]*$", text):
        # A dotted name where an address belongs is a hostname (NF26);
        # a bare word elsewhere is a symbolic constant / service name.
        if "." in text:
            return {"kind": "hostname", "text": text}, []
        return v_lit(text), []
    return v_lit(text), []


def parse_set_element(toks, ctx):
    """One element of a set/map element list: value, or tuple joined
    by '.', or 'key : value' for maps (handled by caller)."""
    # tuple: split on '.' tokens at depth 0
    parts, buf, depth = [], [], 0
    for tok in toks:
        if tok.text == "{":
            depth += 1
        elif tok.text == "}":
            depth -= 1
        if tok.text == "." and depth == 0:
            parts.append(buf)
            buf = []
        else:
            buf.append(tok)
    if buf:
        parts.append(buf)
    if len(parts) > 1:
        vals = []
        for part in parts:
            v, _ = parse_value_tokens(part, ctx)
            vals.append(v)
        return {"kind": "tuple", "values": vals}
    v, _ = parse_value_tokens(toks, ctx)
    return v


