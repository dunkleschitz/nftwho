class Parser:
    def __init__(self, ctx):
        self.ctx = ctx          # EvalContext (holds findings, model, etc.)
        self.tables = {}        # (family, name) -> Table
        self.order = 0          # merged-stream declaration order
        self.unmodeled_commands = []  # (kind, family, table, chain, file, line)

    def table(self, family, name, file, line):
        key = (family, name)
        if key not in self.tables:
            self.tables[key] = Table(family, name, file, line)
        return self.tables[key]

    def parse(self, stmts):
        for stmt in stmts:
            self.parse_top(stmt)
        return self.tables

    def parse_top(self, stmt):
        if not stmt:
            return
        kw = stmt[0].text
        ctx = self.ctx
        if kw == "table":
            self.parse_table(stmt)
        elif kw == "add":
            self.parse_add(stmt)
        elif kw == "flush":
            self.parse_flush(stmt)
        elif kw in ("delete", "insert", "replace", "rename", "list"):
            self.record_unmodeled(stmt)
        elif kw == "define" or kw == "include":
            # handled by the loader; reaching here is a stream error
            ctx.findings.append(Finding("unparseable",
                "stray %s statement" % kw, stmt[0].file, stmt[0].line))
        else:
            ctx.findings.append(Finding(
                "unparseable", "unrecognized top-level statement starting "
                "with %r" % kw, stmt[0].file, stmt[0].line))

    def record_unmodeled(self, stmt):
        kw = stmt[0].text
        fam = tbl = ch = None
        toks = [t.text for t in stmt[1:]]
        for i, t in enumerate(toks):
            if t in FAMILIES and i + 1 < len(toks):
                fam, tbl = t, toks[i + 1]
                if i + 2 < len(toks):
                    ch = toks[i + 2]
                break
        self.unmodeled_commands.append(
            (kw, fam, tbl, ch, stmt[0].file, stmt[0].line))
        self.ctx.findings.append(Finding(
            "unmodeled-command",
            "%s command is not modeled (NF02/NF29)" % kw,
            stmt[0].file, stmt[0].line))

    def parse_table(self, stmt):
        # table FAMILY NAME { ... }
        if len(stmt) < 4 or stmt[3].text != "{":
            self.ctx.findings.append(Finding(
                "unparseable", "malformed table declaration",
                stmt[0].file, stmt[0].line))
            return
        family, name = stmt[1].text, stmt[2].text
        if family not in FAMILIES:
            self.ctx.findings.append(Finding(
                "unparseable", "unknown table family %r" % family,
                stmt[0].file, stmt[0].line))
            return
        inner, _rest = brace_body(stmt[3:])
        if inner is None:
            self.ctx.findings.append(Finding(
                "unparseable", "unbalanced braces in table %s" % name,
                stmt[0].file, stmt[0].line))
            return
        table = self.table(family, name, stmt[0].file, stmt[0].line)
        for sub in split_statements(inner):
            self.parse_table_body(sub, table)

    def parse_table_body(self, stmt, table):
        if not stmt:
            return
        kw = stmt[0].text
        if kw == "chain":
            self.parse_chain(stmt, table)
        elif kw == "set":
            self.parse_set(stmt, table)
        elif kw == "map":
            self.parse_map(stmt, table)
        elif kw in ("counter", "quota", "limit"):
            if len(stmt) >= 2:
                table.objects[stmt[1].text] = (kw, stmt[0].file, stmt[0].line)
        elif kw == "flowtable":
            self.ctx.findings.append(Finding(
                "unmodeled-command",
                "flowtable %s is out of scope (NF05/Out-of-scope)"
                % (stmt[1].text if len(stmt) > 1 else "?"),
                stmt[0].file, stmt[0].line))
        else:
            self.ctx.findings.append(Finding(
                "unparseable",
                "unrecognized declaration %r inside table %s"
                % (kw, table.name), stmt[0].file, stmt[0].line))

    def parse_chain(self, stmt, table):
        # chain NAME { type ... hook ... priority ...; policy ...; rules }
        if len(stmt) < 3 or stmt[2].text != "{":
            self.ctx.findings.append(Finding(
                "unparseable", "malformed chain declaration",
                stmt[0].file, stmt[0].line))
            return
        name = stmt[1].text
        inner, _ = brace_body(stmt[2:])
        if inner is None:
            self.ctx.findings.append(Finding(
                "unparseable", "unbalanced braces in chain %s" % name,
                stmt[0].file, stmt[0].line))
            return
        chain = Chain(table, name, stmt[0].file, stmt[0].line)
        self.order += 1
        chain.stream_index = self.order
        table.chains[name] = chain
        body = split_statements(inner)
        idx = 0
        header_kw = {"type", "policy", "hook", "priority", "device",
                     "comment", "flags"}
        while idx < len(body) and body[idx] and body[idx][0].text in header_kw:
            self.parse_chain_header(body[idx], chain)
            idx += 1
        for rule_stmt in body[idx:]:
            rule = self.parse_rule(rule_stmt, chain)
            chain.rules.append(rule)

    def parse_chain_header(self, stmt, chain):
        toks = stmt
        i = 0
        while i < len(toks):
            kw = toks[i].text
            if kw == "type" and i + 1 < len(toks):
                chain.type = toks[i + 1].text
                i += 2
            elif kw == "hook" and i + 1 < len(toks):
                chain.hook = toks[i + 1].text
                i += 2
            elif kw == "priority":
                j = i + 1
                expr = []
                while j < len(toks) and toks[j].text not in (
                        "type", "hook", "policy", "device", "comment",
                        "flags"):
                    expr.append(toks[j].text)
                    j += 1
                chain.priority_raw = " ".join(expr)
                chain.priority = self.eval_priority(expr, chain)
                i = j
            elif kw == "policy" and i + 1 < len(toks):
                chain.policy = toks[i + 1].text
                chain.policy_line = toks[i + 1].line
                i += 2
            else:
                i += 1

    def eval_priority(self, expr, chain):
        """Constant priority expression over keywords/integers (NF07)."""
        if not expr:
            return 0
        kwmap = (BRIDGE_PRIORITY_KEYWORDS
                 if chain.table.family == "bridge" else PRIORITY_KEYWORDS)
        total = None
        op = "+"
        for tok in expr:
            if tok in ("+", "-"):
                op = tok
                continue
            if tok in kwmap:
                val = kwmap[tok]
            else:
                val = parse_int(tok)
                if val is None:
                    chain.priority_poisoned = True
                    self.ctx.findings.append(Finding(
                        "priority-unknown",
                        "non-constant priority expression %r on chain %s; "
                        "ordering assumes 0" % (" ".join(expr), chain.name),
                        chain.file, chain.line))
                    return 0
            if total is None:
                total = val if op == "+" else -val
            else:
                total = total + val if op == "+" else total - val
            op = "+"
        return total if total is not None else 0

    def parse_set(self, stmt, table):
        if len(stmt) < 3 or stmt[2].text != "{":
            self.ctx.findings.append(Finding(
                "unparseable", "malformed set declaration",
                stmt[0].file, stmt[0].line))
            return
        name = stmt[1].text
        inner, _ = brace_body(stmt[2:])
        if inner is None:
            self.ctx.findings.append(Finding(
                "unparseable", "unbalanced braces in set %s" % name,
                stmt[0].file, stmt[0].line))
            return
        s = NamedSet(table, name, stmt[0].file, stmt[0].line)
        table.sets[name] = s
        for item in split_statements(inner):
            if not item:
                continue
            kw = item[0].text
            if kw == "type":
                s.type = " ".join(t.text for t in item[1:])
            elif kw == "flags":
                for t in item[1:]:
                    if t.text != ",":
                        s.flags.add(t.text)
            elif kw == "elements":
                # elements = { ... }
                eq = [i for i, t in enumerate(item) if t.text == "="]
                if eq and eq[0] + 1 < len(item) and item[eq[0] + 1].text == "{":
                    einner, _ = brace_body(item[eq[0] + 1:])
                    if einner is None:
                        s.poisoned = True
                        s.poison_reason = "unbalanced elements list"
                        continue
                    for part in split_top_commas(einner):
                        s.elements.append(parse_set_element(part, self.ctx))
                else:
                    s.poisoned = True
                    s.poison_reason = "malformed elements list"
            elif kw in ("timeout", "gc-interval", "size", "policy",
                        "comment", "auto-merge"):
                pass
            else:
                # NF29: an unparseable set declaration poisons that
                # set's lookups (only that set's).
                s.poisoned = True
                s.poison_reason = ("unparseable set item %r" % kw)
                self.ctx.findings.append(Finding(
                    "unparseable", "unrecognized set item %r in set %s; "
                    "lookups of this set are poisoned" % (kw, name),
                    item[0].file, item[0].line))
        self.check_set_interval(s)

    def check_set_interval(self, s):
        """NF17: range/prefix elements need flags interval."""
        if "interval" in s.flags:
            return
        for el in s.elements:
            if el.get("kind") in ("prefix", "range"):
                s.poisoned = True
                s.poison_reason = ("range/prefix elements without "
                                   "flags interval (NF17)")
                self.ctx.findings.append(Finding(
                    "set-needs-interval",
                    "set %s has range/prefix elements without flags "
                    "interval; lookups poisoned" % s.name,
                    s.file, s.line))
                return
            if el.get("kind") == "tuple":
                for sub in el["values"]:
                    if sub.get("kind") in ("prefix", "range"):
                        s.poisoned = True
                        s.poison_reason = ("range/prefix elements without "
                                           "flags interval (NF17)")
                        self.ctx.findings.append(Finding(
                            "set-needs-interval",
                            "set %s has range/prefix elements without "
                            "flags interval; lookups poisoned" % s.name,
                            s.file, s.line))
                        return

    def parse_map(self, stmt, table):
        if len(stmt) < 3 or stmt[2].text != "{":
            self.ctx.findings.append(Finding(
                "unparseable", "malformed map declaration",
                stmt[0].file, stmt[0].line))
            return
        name = stmt[1].text
        inner, _ = brace_body(stmt[2:])
        if inner is None:
            self.ctx.findings.append(Finding(
                "unparseable", "unbalanced braces in map %s" % name,
                stmt[0].file, stmt[0].line))
            return
        m = NamedMap(table, name, stmt[0].file, stmt[0].line)
        table.maps[name] = m
        for item in split_statements(inner):
            if not item:
                continue
            kw = item[0].text
            if kw == "type":
                rest = " ".join(t.text for t in item[1:])
                if ":" in rest:
                    kt, vt = rest.split(":", 1)
                    m.key_type = kt.strip()
                    m.value_type = vt.strip()
                else:
                    m.key_type = rest
            elif kw == "flags":
                for t in item[1:]:
                    if t.text != ",":
                        m.flags.add(t.text)
            elif kw == "elements":
                eq = [i for i, t in enumerate(item) if t.text == "="]
                if eq and eq[0] + 1 < len(item) and item[eq[0] + 1].text == "{":
                    einner, _ = brace_body(item[eq[0] + 1:])
                    if einner is None:
                        m.poisoned = True
                        m.poison_reason = "unbalanced elements list"
                        continue
                    for part in split_top_commas(einner):
                        # key : value
                        colon = [i for i, t in enumerate(part)
                                 if t.text == ":"]
                        if not colon:
                            m.poisoned = True
                            m.poison_reason = "map element without ':'"
                            continue
                        ci = colon[0]
                        key = parse_set_element(part[:ci], self.ctx)
                        val = self.parse_map_value(part[ci + 1:])
                        m.elements.append((key, val))
                else:
                    m.poisoned = True
                    m.poison_reason = "malformed elements list"
            elif kw in ("timeout", "gc-interval", "size", "policy",
                        "comment", "auto-merge"):
                pass
            else:
                m.poisoned = True
                m.poison_reason = ("unparseable map item %r" % kw)
                self.ctx.findings.append(Finding(
                    "unparseable", "unrecognized map item %r in map %s; "
                    "lookups of this map are poisoned" % (kw, name),
                    item[0].file, item[0].line))
        # duplicate identical keys are a load error in nft (NF19)
        seen_keys = set()
        for key, _val in m.elements:
            ks = json.dumps(key, sort_keys=True, default=str)
            if ks in seen_keys:
                m.poisoned = True
                m.poison_reason = "duplicate map key (NF19)"
                self.ctx.findings.append(Finding(
                    "load-would-fail",
                    "map %s has a duplicate key; lookups poisoned" % m.name,
                    m.file, m.line))
                break
            seen_keys.add(ks)

    def parse_map_value(self, toks):
        """A map value: verdict (accept/drop/jump X/...), or a literal."""
        if not toks:
            return {"kind": "lit", "text": ""}
        kw = toks[0].text
        if kw in ("accept", "drop", "reject", "queue", "continue", "return"):
            st = {"kind": kw}
            if kw == "reject":
                st["reject_type"] = " ".join(t.text for t in toks[1:])
            return {"kind": "verdict", "stmt": st}
        if kw in ("jump", "goto"):
            return {"kind": "verdict",
                    "stmt": {"kind": kw,
                             "target": toks[1].text if len(toks) > 1 else ""}}
        val, _ = parse_value_tokens(toks, self.ctx)
        return {"kind": "data", "value": val}

    def parse_add(self, stmt):
        # add table | add chain | add rule | add element | add set/map
        if len(stmt) < 2:
            return
        sub = stmt[1].text
        if sub == "table" and len(stmt) >= 4:
            self.table(stmt[2].text, stmt[3].text, stmt[0].file, stmt[0].line)
        elif sub == "chain":
            self.parse_add_chain(stmt)
        elif sub == "rule":
            self.parse_add_rule(stmt)
        elif sub == "element":
            self.parse_add_element(stmt)
        elif sub in ("set", "map") and len(stmt) >= 5:
            fam, tname = stmt[2].text, stmt[3].text
            table = self.table(fam, tname, stmt[0].file, stmt[0].line)
            fake = [Token(sub, stmt[0].file, stmt[0].line)] + stmt[4:]
            if sub == "set":
                self.parse_set(fake, table)
            else:
                self.parse_map(fake, table)
        elif sub in ("counter", "quota", "limit"):
            pass
        else:
            self.ctx.findings.append(Finding(
                "unparseable", "unrecognized add statement %r" % sub,
                stmt[0].file, stmt[0].line))

    def parse_add_chain(self, stmt):
        # add chain FAMILY TABLE NAME [ { ... } ]
        if len(stmt) < 5:
            return
        fam, tname, cname = stmt[2].text, stmt[3].text, stmt[4].text
        table = self.table(fam, tname, stmt[0].file, stmt[0].line)
        chain = Chain(table, cname, stmt[0].file, stmt[0].line)
        self.order += 1
        chain.stream_index = self.order
        table.chains[cname] = chain
        if len(stmt) > 5 and stmt[5].text == "{":
            inner, _ = brace_body(stmt[5:])
            if inner is None:
                return
            body = split_statements(inner)
            idx = 0
            header_kw = {"type", "policy", "hook", "priority", "device",
                         "comment", "flags"}
            while idx < len(body) and body[idx] and body[idx][0].text in header_kw:
                self.parse_chain_header(body[idx], chain)
                idx += 1
            for rule_stmt in body[idx:]:
                chain.rules.append(self.parse_rule(rule_stmt, chain))

    def parse_add_rule(self, stmt):
        # add rule FAMILY TABLE CHAIN <rule tokens>
        if len(stmt) < 6:
            self.ctx.findings.append(Finding(
                "unparseable", "malformed add rule statement",
                stmt[0].file, stmt[0].line))
            return
        fam, tname, cname = stmt[2].text, stmt[3].text, stmt[4].text
        table = self.table(fam, tname, stmt[0].file, stmt[0].line)
        chain = table.chains.get(cname)
        if chain is None:
            chain = Chain(table, cname, stmt[0].file, stmt[0].line)
            self.order += 1
            chain.stream_index = self.order
            table.chains[cname] = chain
            self.ctx.findings.append(Finding(
                "load-would-fail",
                "add rule targets undeclared chain %s (nft would reject "
                "it)" % cname, stmt[0].file, stmt[0].line))
        chain.rules.append(self.parse_rule(stmt[5:], chain))

    def parse_add_element(self, stmt):
        # add element FAMILY TABLE SET { e1, e2, ... }
        if len(stmt) < 6:
            return
        fam, tname, sname = stmt[2].text, stmt[3].text, stmt[4].text
        table = self.table(fam, tname, stmt[0].file, stmt[0].line)
        if len(stmt) > 5 and stmt[5].text == "{":
            inner, _ = brace_body(stmt[5:])
            if inner is None:
                return
            target = table.sets.get(sname) or table.maps.get(sname)
            if target is None:
                self.ctx.findings.append(Finding(
                    "load-would-fail",
                    "add element targets undeclared set/map %s" % sname,
                    stmt[0].file, stmt[0].line))
                return
            if isinstance(target, NamedSet):
                for part in split_top_commas(inner):
                    target.elements.append(parse_set_element(part, self.ctx))
                self.check_set_interval(target)
            else:
                for part in split_top_commas(inner):
                    colon = [i for i, t in enumerate(part) if t.text == ":"]
                    if not colon:
                        continue
                    ci = colon[0]
                    key = parse_set_element(part[:ci], self.ctx)
                    val = self.parse_map_value(part[ci + 1:])
                    target.elements.append((key, val))

    def parse_flush(self, stmt):
        if len(stmt) >= 2 and stmt[1].text == "ruleset":
            self.tables = {}
            self.ctx.findings.append(Finding(
                "info", "flush ruleset discarded all objects modeled so far",
                stmt[0].file, stmt[0].line))
        elif len(stmt) >= 4 and stmt[1].text == "table":
            key = (stmt[2].text, stmt[3].text)
            self.tables.pop(key, None)
        elif len(stmt) >= 5 and stmt[1].text == "chain":
            tbl = self.tables.get((stmt[2].text, stmt[3].text))
            if tbl is not None:
                tbl.chains.pop(stmt[4].text, None)
        elif len(stmt) >= 5 and stmt[1].text == "set":
            tbl = self.tables.get((stmt[2].text, stmt[3].text))
            if tbl is not None and stmt[4].text in tbl.sets:
                tbl.sets[stmt[4].text].elements = []
        else:
            self.ctx.findings.append(Finding(
                "unparseable", "unrecognized flush statement",
                stmt[0].file, stmt[0].line))

    # -- rule parsing -------------------------------------------------

    def parse_rule(self, toks, chain):
        rule = Rule(chain, toks[0].file if toks else chain.file,
                    toks[0].line if toks else chain.line)
        rule.text = " ".join(t.text for t in toks)
        if not toks:
            return rule
        pos = 0
        seen_stmt = False
        while pos < len(toks):
            tok = toks[pos]
            if tok.text.startswith("__UNDEFINED_DEFINE__"):
                name = tok.text.split(":", 1)[1]
                rule.unparseable = True
                rule.unparseable_reason = "undefined-define"
                self.ctx.findings.append(Finding(
                    "undefined-define", "use of undefined define $%s" % name,
                    tok.file, tok.line))
                return rule
            # meta/ct ... set ... is a statement in any position (NF23)
            if tok.text in ("meta", "ct") and not tok.quoted:
                nxt = toks[pos + 1].text if pos + 1 < len(toks) else ""
                after = toks[pos + 2].text if pos + 2 < len(toks) else ""
                if nxt in ("mark", "priority", "label") and after == "set":
                    stmt, pos = self.parse_statement(toks, pos, rule)
                    if stmt:
                        rule.statements.append(stmt)
                    seen_stmt = True
                    continue
            # limit/quota/meter after a match is a statement (NF24:
            # the match-vs-statement position distinction); as the
            # first match it is a rate-shaped match.
            if tok.text in ("limit", "quota", "meter") and rule.matches:
                stmt, pos = self.parse_statement(toks, pos, rule)
                if stmt:
                    rule.statements.append(stmt)
                seen_stmt = True
                continue
            if not seen_stmt and tok.text in FIELD_STARTS and not tok.quoted:
                expr, pos = self.parse_match(toks, pos, rule)
                if expr is not None:
                    if expr.get("kind") == "vmap-stmt":
                        rule.statements.append(expr["stmt"])
                        seen_stmt = True
                    else:
                        rule.matches.append(expr)
                continue
            if tok.text in STATEMENT_KEYWORDS and not tok.quoted:
                stmt, pos = self.parse_statement(toks, pos, rule)
                if stmt:
                    rule.statements.append(stmt)
                seen_stmt = True
                continue
            # A field followed by 'vmap' is a verdict-map statement, and
            # a bare field name (iif/oif) starts a match even after a
            # statement only in the vmap form; anything else here is
            # unclassifiable (NF29).
            rule.unparseable = True
            rule.unparseable_reason = "unrecognized token %r" % tok.text
            self.ctx.findings.append(Finding(
                "unparseable",
                "rule in chain %s has unrecognized token %r; rule poisons "
                "its chain from here (NF29)" % (chain.name, tok.text),
                tok.file, tok.line))
            return rule
        return rule

    def parse_field_spec(self, toks, pos):
        """Parse FIELD [. FIELD]* at pos. Returns (field list, new pos)
        where each entry is (canonical, family, raw) or None if the
        field is unknown (still consumes the tokens)."""
        fields = []
        while True:
            if pos >= len(toks):
                break
            t0 = toks[pos]
            if t0.text in ("iif", "oif", "iifname", "oifname"):
                canon = FIELD_TABLE[(t0.text, None)]
                fields.append((canon[0], canon[1], t0.text))
                pos += 1
            elif pos + 1 < len(toks) and (t0.text, toks[pos + 1].text) in FIELD_TABLE:
                canon = FIELD_TABLE[(t0.text, toks[pos + 1].text)]
                fields.append((canon[0], canon[1],
                               t0.text + " " + toks[pos + 1].text))
                pos += 2
            elif t0.text in ("ip", "ip6", "tcp", "udp", "sctp", "icmp",
                             "icmpv6", "th", "meta", "ct"):
                # known prefix, unknown subfield: consume both, flag it
                sub = toks[pos + 1].text if pos + 1 < len(toks) else "?"
                fields.append((t0.text + " " + sub, None,
                               t0.text + " " + sub))
                pos += 2
            else:
                break
            if pos < len(toks) and toks[pos].text == ".":
                pos += 1
                continue
            break
        return fields, pos

    def parse_match(self, toks, pos, rule):
        """Parse one match expression starting at a field keyword.
        Returns (expr dict, new pos). May return a vmap statement
        instead (kind 'vmap-stmt' marker handled by caller via expr)."""
        start = toks[pos]
        # fib / hash / socket / payload / xt / limit / quota / meter:
        # whole-expression UNKNOWN kinds (NF24/NF25).
        kw = start.text
        if kw == "fib":
            end = pos + 1
            while end < len(toks) and toks[end].text not in STATEMENT_KEYWORDS \
                    and toks[end].text not in ("accept", "drop", "reject",
                                               "queue", "continue", "return",
                                               "jump", "goto"):
                end += 1
            # fib expr is 'fib <addr> [. <if>] type <types>'; stop before
            # a following real match field if one is recognizable after
            # the 'type' values.
            return ({"kind": "poison", "code": "routing-dependent",
                     "message": "fib lookup depends on the kernel routing "
                     "table, not this file (NF25)",
                     "file": start.file, "line": start.line}, end)
        if kw in ("jhash", "symhash", "numgen", "hash"):
            end = pos + 1
            while end < len(toks) and toks[end].text not in STATEMENT_KEYWORDS:
                end += 1
            return ({"kind": "poison", "code": "hash-or-random",
                     "message": "%s is a runtime hash/random expression "
                     "(NF25)" % kw, "file": start.file,
                     "line": start.line}, end)
        if kw == "socket":
            end = pos + 1
            while end < len(toks) and toks[end].text not in STATEMENT_KEYWORDS:
                end += 1
            return ({"kind": "poison", "code": "process-context",
                     "message": "socket match depends on process context "
                     "(NF25)", "file": start.file, "line": start.line}, end)
        if kw == "xt":
            end = pos + 1
            while end < len(toks) and toks[end].text not in STATEMENT_KEYWORDS:
                end += 1
            return ({"kind": "poison", "code": "unmodeled-field",
                     "message": "xtables-compat match is out of scope "
                     "(NF25)", "file": start.file, "line": start.line}, end)
        if kw in ("limit", "quota"):
            # match position: rate-shaped match, runtime fact (NF24)
            end = pos + 1
            while end < len(toks) and toks[end].text not in STATEMENT_KEYWORDS \
                    and toks[end].text not in FIELD_STARTS:
                end += 1
            return ({"kind": "poison", "code": "rate-dependent",
                     "message": "%s as a match depends on traffic already "
                     "passed (NF24)" % kw, "file": start.file,
                     "line": start.line}, end)
        if kw == "meter":
            end = pos + 1
            depth = 0
            while end < len(toks):
                if toks[end].text == "{":
                    depth += 1
                elif toks[end].text == "}":
                    if depth == 0:
                        break
                    depth -= 1
                elif depth == 0 and toks[end].text in STATEMENT_KEYWORDS:
                    break
                end += 1
            return ({"kind": "poison", "code": "rate-dependent",
                     "message": "meter match depends on traffic already "
                     "passed (NF24)", "file": start.file,
                     "line": start.line}, end)
        if kw in ("ether", "vlan", "arp"):
            end = pos + 1
            while end < len(toks) and toks[end].text not in STATEMENT_KEYWORDS \
                    and toks[end].text not in FIELD_STARTS:
                end += 1
            return ({"kind": "poison", "code": "unmodeled-field",
                     "message": "%s header fields are out of the v1 surface "
                     "(NF14)" % kw, "file": start.file,
                     "line": start.line}, end)
        if kw.startswith("@"):
            # raw payload expression @nh/@th/@ll/@ct
            end = pos + 1
            while end < len(toks) and toks[end].text not in STATEMENT_KEYWORDS \
                    and toks[end].text not in FIELD_STARTS:
                end += 1
            return ({"kind": "poison", "code": "unmodeled-field",
                     "message": "raw payload expression is out of the v1 "
                     "surface (NF14/NF25)", "file": start.file,
                     "line": start.line}, end)
        if kw in ("ct",) and pos + 1 < len(toks) and toks[pos + 1].text in (
                "helper", "timeout", "original", "reply", "expectation",
                "id", "label"):
            sub = toks[pos + 1].text
            end = pos + 2
            while end < len(toks) and toks[end].text not in STATEMENT_KEYWORDS \
                    and toks[end].text not in FIELD_STARTS:
                end += 1
            return ({"kind": "poison", "code": "unmodeled-field",
                     "message": "ct %s is outside the modeled ct subset "
                     "(NF21)" % sub, "file": start.file,
                     "line": start.line}, end)

        fields, pos = self.parse_field_spec(toks, pos)
        if not fields:
            return ({"kind": "poison", "code": "unparseable",
                     "message": "unrecognized match field",
                     "file": start.file, "line": start.line}, pos + 1)
        # FIELD vmap ... is a statement, not a match (NF19)
        if pos < len(toks) and toks[pos].text == "vmap":
            stmt, npos = self.parse_vmap(toks, pos, fields, start)
            return ({"kind": "vmap-stmt", "stmt": stmt}, npos)
        # optional negation / mask
        neg = False
        if pos < len(toks) and toks[pos].text == "!":
            neg = True
            pos += 1
        mask = None
        if pos < len(toks) and toks[pos].text == "&":
            pos += 1
            if pos < len(toks):
                mask = toks[pos].text
                pos += 1
                if pos < len(toks) and toks[pos].text == "{":
                    _inner, rest = brace_body(toks[pos:])
                    mask = "{" + " ".join(t.text for t in (_inner or [])) + "}"
                    pos = len(toks) - len(rest)
        op = "=="
        if pos < len(toks) and toks[pos].text in (
                "==", "!=", ">=", "<=", ">", "<"):
            op = toks[pos].text
            pos += 1
        if op == "!=":
            neg = not neg
            op = "=="
        # value, possibly 'a-b' range as three tokens, possibly @named
        if pos < len(toks) and toks[pos].text == "!":
            neg = not neg
            pos += 1
        value, pos = self.parse_match_value(toks, pos, fields)
        return ({"kind": "match", "fields": fields, "op": op, "neg": neg,
                 "mask": mask, "value": value,
                 "file": start.file, "line": start.line}, pos)

    def parse_match_value(self, toks, pos, fields):
        """Parse the value after a field (and optional op). Handles
        three-token ranges (VAL - VAL) and comma lists."""
        if pos >= len(toks):
            return v_unknown("unparseable", "missing match value"), pos
        tok = toks[pos]
        if tok.text.startswith("__UNDEFINED_DEFINE__"):
            name = tok.text.split(":", 1)[1]
            self.ctx.findings.append(Finding(
                "undefined-define", "use of undefined define $%s" % name,
                tok.file, tok.line))
            return v_unknown("undefined-define",
                             "undefined define $%s" % name), pos + 1
        if tok.text == "{":
            inner, rest = brace_body(toks[pos:])
            if inner is None:
                return v_unknown("unparseable", "unbalanced {"), pos + 1
            elems = []
            for part in split_top_commas(inner):
                elems.append(parse_set_element(part, self.ctx))
            return {"kind": "setlit", "elements": elems}, len(toks) - len(rest)
        if tok.text.startswith("@"):
            return {"kind": "named", "name": tok.text[1:]}, pos + 1
        # three-token range: VAL - VAL
        if pos + 2 < len(toks) and toks[pos + 1].text == "-":
            lo = tok.text
            hi = toks[pos + 2].text
            rng = parse_range_token(lo + "-" + hi)
            if rng is not None:
                return {"kind": "range", "rtype": rng[0], "lo": rng[1],
                        "hi": rng[2]}, pos + 3
        first, _ = parse_single_value(tok, self.ctx)
        pos += 1
        if pos < len(toks) and toks[pos].text == ",":
            vals = [first]
            pos += 1
            while pos < len(toks):
                v, _ = parse_single_value(toks[pos], self.ctx)
                vals.append(v)
                pos += 1
                if pos < len(toks) and toks[pos].text == ",":
                    pos += 1
                    continue
                break
            return {"kind": "list", "values": vals}, pos
        return first, pos

    def parse_vmap(self, toks, pos, fields, start):
        """toks[pos] == 'vmap'. Returns (stmt, new pos)."""
        pos += 1  # skip vmap
        if pos < len(toks) and toks[pos].text.startswith("@"):
            return ({"kind": "vmap", "fields": fields,
                     "map": toks[pos].text[1:], "file": start.file,
                     "line": start.line}, pos + 1)
        if pos < len(toks) and toks[pos].text == "{":
            inner, rest = brace_body(toks[pos:])
            if inner is None:
                return ({"kind": "vmap", "fields": fields, "entries": [],
                         "broken": True, "file": start.file,
                         "line": start.line}, pos + 1)
            entries = []
            for part in split_top_commas(inner):
                colon = [i for i, t in enumerate(part) if t.text == ":"]
                if not colon:
                    continue
                ci = colon[0]
                key = parse_set_element(part[:ci], self.ctx)
                val = self.parse_map_value(part[ci + 1:])
                entries.append((key, val))
            return ({"kind": "vmap", "fields": fields, "entries": entries,
                     "file": start.file, "line": start.line},
                    len(toks) - len(rest))
        return ({"kind": "vmap", "fields": fields, "entries": [],
                 "broken": True, "file": start.file,
                 "line": start.line}, pos)

    def parse_statement(self, toks, pos, rule):
        """Parse one statement starting at pos. Returns (stmt, new pos)."""
        start = toks[pos]
        kw = start.text
        if kw in ("accept", "drop", "continue", "return"):
            return {"kind": kw, "file": start.file, "line": start.line}, pos + 1
        if kw == "reject":
            # reject [with TYPE]: TYPE may be 'tcp reset' or
            # 'icmp type <name>' / 'icmpv6 type <name>' — parse the
            # shape structurally instead of scanning for a statement
            # keyword, because 'icmp'/'tcp' are field-start words.
            end = pos + 1
            rest = []
            if end < len(toks) and toks[end].text == "with":
                end += 1
                while end < len(toks) and toks[end].text not in \
                        STATEMENT_KEYWORDS:
                    rest.append(toks[end].text)
                    end += 1
                    if rest and rest[-1] in ("reset",):
                        break
                    if len(rest) >= 3 and rest[0] in ("icmp", "icmpv6"):
                        break
                    if len(rest) >= 4:
                        break
            return ({"kind": "reject",
                     "reject_type": " ".join(rest),
                     "file": start.file, "line": start.line}, end)
        if kw == "queue":
            end = pos + 1
            while end < len(toks) and toks[end].text not in STATEMENT_KEYWORDS \
                    and toks[end].text not in FIELD_STARTS:
                end += 1
            return ({"kind": "queue", "file": start.file,
                     "line": start.line}, end)
        if kw in ("jump", "goto"):
            target = toks[pos + 1].text if pos + 1 < len(toks) else ""
            return ({"kind": kw, "target": target, "file": start.file,
                     "line": start.line}, pos + 2)
        if kw in ("log", "counter", "dup", "fwd", "synproxy", "notrack",
                  "limit", "quota", "meter", "flow", "reroute", "update"):
            end = pos + 1
            depth = 0
            while end < len(toks):
                t = toks[end].text
                if t == "{":
                    depth += 1
                elif t == "}":
                    if depth == 0:
                        break
                    depth -= 1
                elif depth == 0 and (t in STATEMENT_KEYWORDS
                                     or t in FIELD_STARTS):
                    break
                end += 1
            if kw == "notrack":
                return ({"kind": "notrack", "file": start.file,
                         "line": start.line}, end)
            if kw == "flow":
                return ({"kind": "flow", "file": start.file,
                         "line": start.line}, end)
            if kw == "reroute":
                return ({"kind": "reroute", "file": start.file,
                         "line": start.line}, end)
            return ({"kind": "stmt-" + kw, "args": [t.text for t in toks[pos + 1:end]],
                     "file": start.file, "line": start.line}, end)
        if kw in ("meta", "ct"):
            # meta mark set VALUE [map @NAME] | ct mark set ... |
            # meta priority set ... | ct label set ...
            if pos + 2 < len(toks) and toks[pos + 2].text == "set":
                which = toks[pos + 1].text
                end = pos + 3
                depth = 0
                # The value may itself be a field reference ('meta mark
                # set ct mark'), so stop only at statement keywords,
                # never at a field-start token.
                while end < len(toks):
                    t = toks[end].text
                    if t == "{":
                        depth += 1
                    elif t == "}":
                        if depth == 0:
                            break
                        depth -= 1
                    elif depth == 0 and t in STATEMENT_KEYWORDS:
                        break
                    end += 1
                val_toks = toks[pos + 3:end]
                kind = {"mark": "mark-set", "priority": "mark-set",
                        "label": "mark-set"}.get(which, "mark-set")
                if kw == "ct" and which == "mark":
                    kind = "ctmark-set"
                elif kw == "meta" and which == "mark":
                    kind = "mark-set"
                else:
                    # meta priority set / ct label set: tracked as a
                    # finding only (NF23) — no v1 field reads them.
                    return ({"kind": "stmt-" + kw, "args": [],
                             "file": start.file, "line": start.line}, end)
                return ({"kind": kind, "value_toks": val_toks,
                         "file": start.file, "line": start.line}, end)
            # 'meta ...' as a statement that is not a set: unclassifiable
            rule.unparseable = True
            rule.unparseable_reason = "unrecognized meta statement"
            self.ctx.findings.append(Finding(
                "unparseable", "unrecognized meta/ct statement in chain %s"
                % rule.chain.name, start.file, start.line))
            return None, len(toks)
        if kw in ("masquerade", "redirect"):
            end = pos + 1
            target = None
            if end < len(toks) and toks[end].text == "to":
                end += 1
                tgt = []
                while end < len(toks) and toks[end].text not in STATEMENT_KEYWORDS \
                        and toks[end].text not in FIELD_STARTS:
                    tgt.append(toks[end])
                    end += 1
                target = " ".join(t.text for t in tgt) if tgt else None
            return ({"kind": "nat", "nat_kind": kw, "target": target,
                     "file": start.file, "line": start.line}, end)
        if kw in ("snat", "dnat"):
            end = pos + 1
            target = None
            mapref = None
            keyfield = None
            if end < len(toks) and toks[end].text == "to":
                end += 1
                # forms: ADDR | ADDR:PORT | FIELD map @NAME | FIELD
                if end < len(toks) and toks[end].text in FIELD_STARTS:
                    fields, end = self.parse_field_spec(toks, end)
                    keyfield = fields
                    if end < len(toks) and toks[end].text == "map":
                        end += 1
                        if end < len(toks) and toks[end].text.startswith("@"):
                            mapref = toks[end].text[1:]
                            end += 1
                else:
                    tgt = []
                    while end < len(toks) and toks[end].text not in STATEMENT_KEYWORDS \
                            and toks[end].text not in FIELD_STARTS:
                        tgt.append(toks[end])
                        end += 1
                    target = " ".join(t.text for t in tgt) if tgt else None
            return ({"kind": "nat", "nat_kind": kw, "target": target,
                     "map": mapref, "keyfield": keyfield,
                     "file": start.file, "line": start.line}, end)
        if kw == "tproxy":
            end = pos + 1
            while end < len(toks) and toks[end].text not in STATEMENT_KEYWORDS \
                    and toks[end].text not in FIELD_STARTS:
                end += 1
            return ({"kind": "nat", "nat_kind": "tproxy",
                     "target": " ".join(t.text for t in toks[pos + 1:end]),
                     "file": start.file, "line": start.line}, end)
        # Unknown statement keyword: the rule's execution is
        # UNKNOWN-if-matched (NF29).
        rule.unparseable = True
        rule.unparseable_reason = "unrecognized statement %r" % kw
        self.ctx.findings.append(Finding(
            "unparseable",
            "rule in chain %s has unrecognized statement %r; execution "
            "UNKNOWN-if-matched (NF29)" % (rule.chain.name, kw),
            start.file, start.line))
        return None, len(toks)

